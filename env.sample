# (Required) Tailscale auth
TAILSCALE_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAILSCALE_HOSTNAME=derp

# (Optional) Custom login server (e.g. Headscale)
# TAILSCALE_LOGIN_SERVER=https://xxxxxxxxx.net

# (Optional) Advertise as exit node (true/false)
# TAILSCALE_ADVERTISE_EXIT_NODE=false

# (Optional) Advertise subnet routes (comma-separated CIDRs)
# TAILSCALE_ADVERTISE_ROUTES=

# (Optional) Accept routes from other nodes (true/false)
# TAILSCALE_ACCEPT_ROUTES=false

# (Optional) Accept DNS from Tailscale (true/false)
# TAILSCALE_ACCEPT_DNS=true

# (Optional) Extra tailscale up flags (escape hatch)
# TAILSCALE_EXTRA_ARGS=

# (Optional) State storage: "mem:" (ephemeral) or "/app/states" (persistent)
TAILSCALED_STATE_ARG="/app/states"

# (Optional, tailscale-userspace) SOCKS5 proxy listen address
TAILSCALED_SOCKS5_SERVER=0.0.0.0:1055

# (Optional, tailscale-userspace) HTTP proxy listen address
TAILSCALED_HTTP_PROXY=0.0.0.0:1056

# (Optional) Extra tailscaled flags (escape hatch)
# TAILSCALED_EXTRA_ARGS=

# (Required, tailscale-derp) DERP server config
DERP_DOMAIN=xxxxxxxxx.net
DERP_VERIFY_CLIENTS=true
# DERP_CERT_MODE=letsencrypt
# DERP_CERT_DIR=/app/certs
